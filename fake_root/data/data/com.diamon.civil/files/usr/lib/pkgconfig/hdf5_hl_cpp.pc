prefix=/data/data/com.diamon.civil/files/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: hdf5_hl_cpp
Description: HDF5 (Hierarchical Data Format 5) Software Library
Version: 2.3.0

Cflags: -I${includedir} 
Libs: -L${libdir} -lhdf5_hl_cpp
Requires: hdf5_cpp = 2.3.0, hdf5_hl = 2.3.0
Libs.private: 
Requires.private: hdf5_cpp = 2.3.0, hdf5_hl = 2.3.0
