    <string name="disclaimer_dialog_title">Data Reliability &amp; Educational Use</string>
    <string name="disclaimer_dialog_message"><![CDATA[<b>EDUCATIONAL &amp; PRELIMINARY ESTIMATIONS</b><br/><br/>This application is designed as a learning tool for <b>educational purposes, academic study, and preliminary estimations</b>.<br/><br/><b>DATA RELIABILITY NOTICE:</b><br/>Finite Element Analysis (FEA) results, internal force diagrams, and generated calculation memos are numerical approximations for guidance only. Due to modeling simplifications and computation tolerances on mobile devices, <b>the output data should not be considered 100% reliable or conclusive</b>.<br/><br/>Always verify and cross-check calculations with certified professional engineering software and licensed engineers. The developer assumes no liability for decisions made based on these results.]]></string>

    <string name="about_dialog_title">About Structural Analysis FEA 3D</string>
    <string name="about_dialog_message"><![CDATA[<b>Structural Analysis FEA 3D v0.1.0</b><br/><br/>High-performance 3D Solid &amp; Frame Finite Element Analysis (FEA) platform for Android.<br/>Powered by CalculiX (CCX 2.23), Gmsh 3D mesh generator (v5.0.0), and OpenCASCADE Technology (OCCT 8.0.0.p1).<br/><br/><b>Lead Developer:</b> Daniel Diamon<br/><b>License:</b> GNU General Public License v3.0 (GPLv3)<br/><b>Repository:</b> <a href="https://github.com/Danielk10/Calculo_Estructural">GitHub Repository</a>]]></string>
    <string name="licenses_dialog_title">About &amp; Licenses</string>
